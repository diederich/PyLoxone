#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")/.."

usage() {
  echo "Usage: scripts/deploy [--reload]"
  echo ""
  echo "  (default)    Sync files and restart Home Assistant Core (~30-60s)"
  echo "  --reload     Sync files and reload the integration only (~2s)"
  echo "               ⚠ Reload does NOT pick up Python source changes — only"
  echo "               use this for YAML/config tweaks or when you know the"
  echo "               Python modules haven't changed."
}

MODE="restart"
for arg in "$@"; do
  case "$arg" in
    --reload) MODE="reload" ;;
    --restart) MODE="restart" ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $arg"; usage; exit 1 ;;
  esac
done

ENV_FILE=".deploy.env"
if [ ! -f "$ENV_FILE" ]; then
  echo "Error: $ENV_FILE not found. Create it with:"
  echo '  HA_URL="http://your-ha-host:8123"'
  echo '  HA_SSH="your-ha-host"'
  echo '  HA_CONFIG="/config"'
  echo '  HA_TOKEN="your-long-lived-access-token"  # for fast reloads'
  exit 1
fi
source "$ENV_FILE"

check_ssh() {
  if ssh -o BatchMode=yes -o ConnectTimeout=5 "$HA_SSH" true &>/dev/null; then
    return 0
  fi

  echo "Error: cannot connect to $HA_SSH with non-interactive SSH."
  echo ""
  echo "If you normally need to unlock your SSH key first, run:"
  echo "  ssh-add"
  echo ""
  echo "Then verify the deploy connection with:"
  echo "  ssh -o BatchMode=yes \"$HA_SSH\" true"
  echo ""
  echo "For more detail:"
  echo "  ssh-add -l"
  echo "  ssh -v \"$HA_SSH\" true"
  exit 1
}

if [ "$MODE" = "reload" ] && [ -z "${HA_TOKEN:-}" ]; then
  echo "Warning: HA_TOKEN not set — cannot reload, falling back to full restart."
  echo "  For fast reloads (~2s), create a long-lived access token:"
  echo "  HA → Profile → Security → Long-Lived Access Tokens"
  echo ""
  MODE="restart"
fi

REMOTE_DIR="$HA_CONFIG/custom_components/loxone"
LOCAL_DIR="custom_components/loxone"

if [ ! -d "$LOCAL_DIR" ]; then
  echo "Error: Could not find $LOCAL_DIR from repo root."
  exit 1
fi

check_ssh

FRONTEND_DIR="$LOCAL_DIR/frontend"
if [ -f "$FRONTEND_DIR/build.mjs" ]; then
  if [ ! -d "$FRONTEND_DIR/node_modules" ]; then
    echo "==> Installing frontend dependencies..."
    (cd "$FRONTEND_DIR" && npm ci --silent)
  fi
  echo "==> Building frontend..."
  (cd "$FRONTEND_DIR" && node build.mjs)
fi

echo "==> Deploying to $HA_SSH:$REMOTE_DIR ..."

if ssh "$HA_SSH" "command -v rsync" &>/dev/null; then
  rsync -avz --delete \
    --exclude='__pycache__' \
    --exclude='*.pyc' \
    --exclude='frontend/node_modules' \
    --exclude='frontend/src' \
    --exclude='frontend/test' \
    --exclude='frontend/package.json' \
    --exclude='frontend/package-lock.json' \
    --exclude='frontend/tsconfig.json' \
    --exclude='frontend/vitest.config.ts' \
    --exclude='frontend/build.mjs' \
    "$LOCAL_DIR/" "$HA_SSH:$REMOTE_DIR/"
else
  echo "    (rsync not available on remote, using scp)"
  ssh "$HA_SSH" "rm -rf $REMOTE_DIR"
  scp -r "$LOCAL_DIR" "$HA_SSH:$HA_CONFIG/custom_components/"
fi

if [ "$MODE" = "restart" ]; then
  echo "==> Restarting Home Assistant Core..."
  ssh "$HA_SSH" "ha core restart"
  echo "==> Restart triggered. HA will be back in ~30-60s."
else
  echo "==> Reloading Loxone integration..."
  HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" \
    -X POST "$HA_URL/api/services/loxone/reload" \
    -H "Authorization: Bearer $HA_TOKEN" \
    -H "Content-Type: application/json" \
    -d '{}')
  if [ "$HTTP_CODE" -ge 200 ] && [ "$HTTP_CODE" -lt 300 ]; then
    echo "==> Reload complete (~2s)."
  else
    echo "==> Reload failed (HTTP $HTTP_CODE). Try 'scripts/deploy --restart'."
    exit 1
  fi
fi

echo "    Logs: $HA_URL/config/logs"
